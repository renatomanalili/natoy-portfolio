---
import { PROJECTS as projects } from "../constants/index.js";
---

<div
  id="projects-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-bg-dark/80 backdrop-blur-sm"
>
  <div
    class="bg-bg-base border border-border-default rounded-xl w-full max-w-4xl mx-3 sm:mx-6 max-h-[90vh] flex flex-col overflow-hidden"
  >
    <div id="modal-grid-view" class="flex flex-col overflow-hidden">
      <div
        class="flex items-center justify-between px-4 sm:px-6 py-4 border-b border-border-default shrink-0"
      >
        <div class="flex flex-col gap-1">
          <h2 class="text-xl font-bold text-text-primary">
            Things I've Built
          </h2>
          <p class="text-xs text-text-muted">
            5 of 50+ delivered — most under NDA.
          </p>
        </div>
        <button
          id="close-projects-modal"
          class="text-text-faint hover:text-text-primary transition-colors cursor-pointer"
          aria-label="Close"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <div class="overflow-y-auto p-4 sm:p-6">
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
        >
          {
            projects.map((p, i) => (
              <button
                class="project-card text-left bg-bg-deep border border-border-default rounded-xl p-5 flex flex-col gap-3 hover:border-border-strong transition-colors cursor-pointer"
                data-index={i}
              >
                <div class="flex items-start justify-between">
                  <span class="font-mono text-xs text-cyan">
                    {p.num}
                  </span>
                  {p.link ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-text-faint"
                    >
                      <path d="M15 3h6v6" />
                      <path d="M10 14 21 3" />
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    </svg>
                  ) : (
                    <span class="font-mono text-[10px] text-text-faint border border-border-faint rounded px-1.5 py-0.5">
                      NDA
                    </span>
                  )}
                </div>
                <h3 class="font-bold text-sm text-text-primary">
                  {p.title}
                </h3>
                <p class="text-xs text-text-muted leading-relaxed flex-1">
                  {p.description}
                </p>
                <div class="flex flex-wrap gap-1.5 mt-1">
                  {p.stack.map((tag) => (
                    <span class="font-mono text-[11px] text-text-secondary bg-bg-dark border border-border-faint rounded px-2 py-0.5">
                      {tag}
                    </span>
                  ))}
                </div>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Detail view -->
    <div
      id="modal-detail-view"
      class="flex-col overflow-hidden flex-1"
      style="display:none"
    >
      <div
        class="flex items-center justify-between px-6 py-4 border-b border-border-default shrink-0"
      >
        <button
          id="back-to-grid"
          class="flex items-center gap-2 text-text-faint hover:text-text-primary transition-colors cursor-pointer text-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          All Projects
        </button>
        <button
          id="close-from-detail"
          class="text-text-faint hover:text-text-primary transition-colors cursor-pointer"
          aria-label="Close"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <div
        class="flex flex-col lg:flex-row gap-6 lg:gap-8 p-4 sm:p-6 overflow-y-auto flex-1"
      >
        <!-- Carousel -->
        <div
          id="carousel-image-container"
          class="flex flex-col gap-3 w-full lg:w-[55%] lg:shrink-0"
        >
          <div
            class="relative bg-bg-deep border border-border-default rounded-xl overflow-hidden aspect-video flex items-center justify-center"
          >
            <img
              id="carousel-img"
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
            <button
              id="carousel-prev"
              class="absolute left-3 top-1/2 -translate-y-1/2 bg-bg-base/80 hover:bg-bg-base border border-border-default rounded-lg p-1.5 text-text-secondary hover:text-text-primary transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m15 18-6-6 6-6"></path>
              </svg>
            </button>
            <button
              id="carousel-next"
              class="absolute right-3 top-1/2 -translate-y-1/2 bg-bg-base/80 hover:bg-bg-base border border-border-default rounded-lg p-1.5 text-text-secondary hover:text-text-primary transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </button>
          </div>
          <div
            id="carousel-dots"
            class="flex items-center justify-center gap-1.5"
          >
          </div>
        </div>

        <!-- Project info -->
        <div class="flex flex-col gap-4 flex-1">
          <span id="detail-num" class="font-mono text-xs text-cyan"
          ></span>
          <h3
            id="detail-title"
            class="text-xl font-bold text-text-primary"
          >
          </h3>
          <p
            id="detail-desc"
            class="text-sm text-text-muted leading-relaxed"
          >
          </p>
          <div id="detail-stack" class="flex flex-wrap gap-1.5"></div>
          <a
            id="detail-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto w-fit flex items-center gap-2 text-sm font-medium text-cyan hover:text-cyan/70 transition-colors"
            style="display:none"
          >
            View Project
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 3h6v6"></path><path d="M10 14 21 3"
              ></path><path
                d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ projects }} is:inline>
  const modal = document.getElementById("projects-modal");
  const openBtn = document.getElementById("open-projects-modal");
  const closeBtn = document.getElementById("close-projects-modal");
  const closeFromDetail = document.getElementById(
    "close-from-detail",
  );
  const gridView = document.getElementById("modal-grid-view");
  const detailView = document.getElementById("modal-detail-view");
  const backBtn = document.getElementById("back-to-grid");

  // Carousel elements
  const carouselContainer = document.getElementById(
    "carousel-image-container",
  );
  const carouselImg = document.getElementById("carousel-img");
  const carouselDots = document.getElementById("carousel-dots");
  const prevBtn = document.getElementById("carousel-prev");
  const nextBtn = document.getElementById("carousel-next");

  // Detail info elements
  const detailNum = document.getElementById("detail-num");
  const detailTitle = document.getElementById("detail-title");
  const detailDesc = document.getElementById("detail-desc");
  const detailStack = document.getElementById("detail-stack");
  const detailLink = document.getElementById("detail-link");

  let currentImages = [];
  let currentIndex = 0;

  const openModal = () => {
    modal.style.display = "flex";
    document.body.style.overflow = "hidden";
  };

  const closeModal = () => {
    modal.style.display = "none";
    document.body.style.overflow = "";
    showGrid();
  };

  const showGrid = () => {
    detailView.style.display = "none";
    gridView.style.display = "flex";
  };

  const showDetail = (index) => {
    const p = projects[index];
    currentImages = p.images;
    currentIndex = 0;

    detailNum.textContent = p.num;
    detailTitle.textContent = p.title;
    detailDesc.textContent = p.description;

    detailStack.innerHTML = p.stack
      .map(
        (tag) =>
          `<span class="font-mono text-[11px] text-text-secondary bg-bg-dark border border-border-faint rounded px-2 py-0.5">${tag}</span>`,
      )
      .join("");

    if (p.link) {
      detailLink.href = p.link;
      detailLink.style.display = "flex";
    } else {
      detailLink.style.display = "none";
    }

    if (p.images.length === 0) {
      carouselContainer.style.display = "none";
      prevBtn.style.display = "none";
      nextBtn.style.display = "none";
      carouselDots.innerHTML = "";
    } else {
      renderCarousel();
    }

    gridView.style.display = "none";
    detailView.style.display = "flex";
  };

  const renderCarousel = () => {
    carouselImg.src = currentImages[currentIndex];
    carouselImg.alt = `Screenshot ${currentIndex + 1}`;

    carouselDots.innerHTML = currentImages
      .map(
        (_, i) =>
          `<button class="carousel-dot w-2 h-2 rounded-full transition-colors ${i === currentIndex ? "bg-cyan" : "bg-border-strong"}" data-dot="${i}"></button>`,
      )
      .join("");

    carouselDots.querySelectorAll(".carousel-dot").forEach((dot) => {
      dot.addEventListener("click", () => {
        currentIndex = Number(dot.dataset.dot);
        renderCarousel();
      });
    });

    prevBtn.style.display = currentImages.length > 1 ? "" : "none";
    nextBtn.style.display = currentImages.length > 1 ? "" : "none";
  };

  prevBtn.addEventListener("click", () => {
    currentIndex =
      (currentIndex - 1 + currentImages.length) %
      currentImages.length;
    renderCarousel();
  });

  nextBtn.addEventListener("click", () => {
    currentIndex = (currentIndex + 1) % currentImages.length;
    renderCarousel();
  });

  document.querySelectorAll(".project-card").forEach((card) => {
    card.addEventListener("click", () =>
      showDetail(Number(card.dataset.index)),
    );
  });

  openBtn?.addEventListener("click", openModal);
  closeBtn.addEventListener("click", closeModal);
  closeFromDetail.addEventListener("click", closeModal);
  backBtn.addEventListener("click", showGrid);

  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
    if (e.key === "ArrowLeft") {
      if (!detailView.classList.contains("hidden")) {
        currentIndex =
          (currentIndex - 1 + currentImages.length) %
          currentImages.length;
        renderCarousel();
      }
    }
    if (e.key === "ArrowRight") {
      if (!detailView.classList.contains("hidden")) {
        currentIndex = (currentIndex + 1) % currentImages.length;
        renderCarousel();
      }
    }
  });
</script>
