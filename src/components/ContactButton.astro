---
const {
  icon = "/contacts/email-icon.webp",
  label,
  value,
} = Astro.props;
---

<button
  class="flex items-center justify-between w-full px-5 py-3.5 bg-bg-muted hover:bg-bg-hover border border-bg-elevated hover:border-cyan rounded-[10px] gap-3.5 text-border-strong hover:text-cyan transition-colors"
>
  <div class="flex items-center gap-3.5">
    <img src={icon} alt={label} class="h-4.5 w-4.5" />
    <div class="flex flex-col items-start gap-0.5 font-mono">
      <h3 class="uppercase text-text-muted font-bold text-[10px]">
        {label}
      </h3>
      <p class="text-[13px] text-text-primary">{value}</p>
    </div>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-arrow-up-right-icon lucide-arrow-up-right"
    ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
  >
</button>
