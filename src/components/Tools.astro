---
import Badge from "./Badge.astro";
import ToolsContainer from "./ToolsContainer.astro";
import ToolsBlock from "./ToolsBlock.astro";
import { TOOLS } from "../constants";
---

<section class="flex flex-col items-start w-full gap-12 p-20">
  <div class="flex flex-col items-start gap-2.5">
    <Badge label="tech_stack" />
    <h2 class="text-3xl font-bold text-text-primary">
      Tools I Work With
    </h2>
    <p class="text-[15px] text-text-muted">
      A curated set of technologies I use to build fast, scalable, and <br
      />
      maintainable products — from UI to infrastructure.
    </p>
  </div>
  <div class="flex items-start w-full gap-6">
    {
      TOOLS.map((tool) => (
        <ToolsContainer
          key={tool.label}
          label={tool.label}
          variant={tool.variant}
        >
          {tool.items.map((item) => (
            <ToolsBlock key={item.label} label={item.label} />
          ))}
        </ToolsContainer>
      ))
    }
  </div>
</section>
