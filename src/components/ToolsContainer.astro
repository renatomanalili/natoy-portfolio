---
import clsx from "clsx";
import { TOOL_VARIANTS } from "../constants";

const { variant = "frontend", label = "frontend" } = Astro.props;
---

<div
  class="flex flex-col items-start gap-4 p-6 border bg-bg-muted border-bg-elevated rounded-xl"
>
  <h3
    class={clsx(
      "font-bold text-[10px] uppercase border-l-[3px] pl-1.5 font-mono",
      TOOL_VARIANTS[variant].color,
    )}
  >
    {label}
  </h3>
  <div class="flex flex-col items-start w-full gap-2">
    <slot />
  </div>
</div>
