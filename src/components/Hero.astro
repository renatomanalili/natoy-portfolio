---
import Badge from "./Badge.astro";
import ProjectsModal from "./ProjectsModal.astro";

type Token = { text: string; cls: string };
type Line = { parts: Token[]; indent: string };

const kw = (t: string): Token => ({ text: t, cls: "text-purple" });
const key = (t: string): Token => ({ text: t, cls: "text-cyan" });
const str = (t: string): Token => ({ text: t, cls: "text-amber" });
const bool = (t: string): Token => ({ text: t, cls: "text-green" });
const dim = (t: string): Token => ({
  text: t,
  cls: "text-text-faint",
});
const plain = (t: string): Token => ({
  text: t,
  cls: "text-text-primary",
});

const about: Line[] = [
  { indent: "", parts: [kw("const"), plain(" about"), dim(" = {")] },
  {
    indent: "ml-5",
    parts: [
      key('"name"'),
      dim(": "),
      str('"Renato Manalili"'),
      dim(","),
    ],
  },
  {
    indent: "ml-5",
    parts: [
      key('"email"'),
      dim(": "),
      str('"renatomanalili.dev@gmail.com"'),
      dim(","),
    ],
  },
  {
    indent: "ml-5",
    parts: [
      key('"role"'),
      dim(": "),
      str('"Full-Stack Developer"'),
      dim(","),
    ],
  },
  {
    indent: "ml-5",
    parts: [
      key('"location"'),
      dim(": "),
      str('"Philippines"'),
      dim(","),
    ],
  },
  {
    indent: "ml-5",
    parts: [key('"available"'), dim(": "), bool("true"), dim(",")],
  },
  { indent: "ml-5", parts: [key('"focus"'), dim(": [")] },
  { indent: "ml-10", parts: [str('"React"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Vue.js"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Supabase"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Node.js"'), dim(",")] },
  { indent: "ml-10", parts: [str('"TypeScript"'), dim(",")] },
  { indent: "ml-5", parts: [dim("],")] },
  {
    indent: "ml-5",
    parts: [key('"currently_learning"'), dim(": [")],
  },
  { indent: "ml-10", parts: [str('"Playwright"'), dim(",")] },
  { indent: "ml-5", parts: [dim("],")] },
  { indent: "ml-5", parts: [key('"open_to"'), dim(": [")] },
  { indent: "ml-10", parts: [str('"remote"'), dim(",")] },
  { indent: "ml-10", parts: [str('"freelance"'), dim(",")] },
  { indent: "ml-10", parts: [str('"full-time"'), dim(",")] },
  { indent: "ml-5", parts: [dim("]")] },
  { indent: "", parts: [dim("}")] },
];

const skills: Line[] = [
  { indent: "", parts: [kw("const"), plain(" skills"), dim(" = {")] },
  { indent: "ml-5", parts: [key('"frontend"'), dim(": [")] },
  { indent: "ml-10", parts: [str('"Vue.js"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Nuxt.js"'), dim(",")] },
  { indent: "ml-10", parts: [str('"React"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Next.js"'), dim(",")] },
  { indent: "ml-10", parts: [str('"React Native"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Astro.js"'), dim(",")] },
  { indent: "ml-10", parts: [str('"TailwindCSS"'), dim(",")] },
  { indent: "ml-10", parts: [str('"TypeScript"'), dim(",")] },
  { indent: "ml-5", parts: [dim("],")] },
  { indent: "ml-5", parts: [key('"backend"'), dim(": [")] },
  { indent: "ml-10", parts: [str('"Node.js"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Express"'), dim(",")] },
  { indent: "ml-10", parts: [str('"NestJS"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Laravel"'), dim(",")] },
  { indent: "ml-10", parts: [str('"PHP"'), dim(",")] },
  { indent: "ml-5", parts: [dim("],")] },
  { indent: "ml-5", parts: [key('"database"'), dim(": [")] },
  { indent: "ml-10", parts: [str('"PostgreSQL"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Supabase"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Neon"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Firebase"'), dim(",")] },
  { indent: "ml-10", parts: [str('"MongoDB"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Drizzle ORM"'), dim(",")] },
  { indent: "ml-5", parts: [dim("],")] },
  { indent: "ml-5", parts: [key('"tools"'), dim(": [")] },
  { indent: "ml-10", parts: [str('"Git"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Netlify"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Vercel"'), dim(",")] },
  { indent: "ml-10", parts: [str('"Docker"'), dim(",")] },
  { indent: "ml-5", parts: [dim("],")] },
  { indent: "", parts: [dim("}")] },
];
---

<section
  class="flex flex-col lg:flex-row items-center justify-between min-h-screen px-6 lg:px-20 py-16 lg:py-0 gap-12 lg:gap-0"
>
  <div class="flex flex-col items-start gap-7 w-full lg:w-auto">
    <Badge label="Available for freelance work" />
    <h2
      class="text-[38px] sm:text-[50px] lg:text-[60px] font-bold text-text-primary leading-[115%]"
    >
      Full-Stack <br /> Web Developer
    </h2>
    <p
      class="text-[15px] lg:text-[17px] text-text-muted leading-[160%] max-w-lg"
    >
      I build scalable web applications, high-performance APIs, and
      modern user experiences — from clean frontends to robust backend
      systems.
    </p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/renatomanalili"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-faint hover:text-text-primary transition-colors"
        aria-label="GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
      </a>
      <a
        href="https://www.linkedin.com/in/renato-manalili-jr/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-faint hover:text-text-primary transition-colors"
        aria-label="LinkedIn"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
          ></path>
        </svg>
      </a>
    </div>
    <div class="flex items-center gap-3">
      <button
        id="open-projects-modal"
        class="btn-primary h-10.5 text-sm font-bold px-7"
        >View Projects</button
      >
      <button class="btn-secondary h-10.5 text-sm font-semibold px-7"
        >Hire Me</button
      >
    </div>

    <div class="flex items-center gap-7">
      <div class="flex flex-col items-start gap-0.5 font-mono">
        <h3 class="text-2xl font-bold text-cyan">7+</h3>
        <p class="text-xs text-text-muted">Years Exp.</p>
      </div>
      <div class="flex flex-col items-start gap-0.5 font-mono">
        <h3 class="text-2xl font-bold text-cyan">50+</h3>
        <p class="text-xs text-text-muted">Projects Built</p>
      </div>
    </div>
  </div>
  <div
    class="bg-bg-base border border-border-default rounded-xl w-full max-w-2xl h-85 sm:h-105 lg:h-115 overflow-hidden pb-10"
  >
    <div
      class="flex items-center w-full bg-bg-deep px-3.5 rounded-t-xl border-b border-border-default"
    >
      <div class="flex items-center justify-center h-10 gap-1.5">
        <div class="h-2.5 w-2.5 bg-close rounded-full"></div>
        <div class="h-2.5 w-2.5 bg-maximize rounded-full"></div>
        <div class="h-2.5 w-2.5 bg-minimize rounded-full"></div>
      </div>
      <div class="tabs ml-3.5">
        <div class="flex items-center" role="tablist">
          <button class="tab active" role="tab" data-target="tab1"
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-code-icon lucide-code"
              ><path d="m16 18 6-6-6-6"></path><path d="m8 6-6 6 6 6"
              ></path></svg
            ><span>about.ts</span></button
          >
          <button class="tab" role="tab" data-target="tab2"
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-code-icon lucide-code"
              ><path d="m16 18 6-6-6-6"></path><path d="m8 6-6 6 6 6"
              ></path></svg
            ><span>skills.ts</span></button
          >
        </div>
      </div>
      <button
        class="text-text-faint ml-auto cursor-pointer hover:text-text-faint/50 transition-colors"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-maximize2-icon lucide-maximize-2"
          ><path d="M15 3h6v6"></path><path d="m21 3-7 7"></path><path
            d="m3 21 7-7"></path><path d="M9 21H3v-6"></path></svg
        ></button
      >
    </div>
    <div
      class="tab-content active overflow-y-scroll h-full"
      id="tab1"
    >
      <ul class="text-text-subtle font-mono text-xs space-y-1">
        {about.map((t, i) => <li>{i + 1}</li>)}
      </ul>
      <ul class="font-mono text-xs space-y-1">
        {
          about.map((t) => (
            <li class={t.indent}>
              {t.parts.map((p) => (
                <span class={p.cls}>{p.text}</span>
              ))}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="tab-content overflow-y-scroll h-full" id="tab2">
      <ul class="text-text-subtle font-mono text-xs space-y-1">
        {skills.map((_, i) => <li>{i + 1}</li>)}
      </ul>
      <ul class="font-mono text-xs space-y-1">
        {
          skills.map((s) => (
            <li class={s.indent}>
              {s.parts.map((p) => (
                <span class={p.cls}>{p.text}</span>
              ))}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<ProjectsModal />

<script>
  document.querySelectorAll(".tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document
        .querySelectorAll(".tab, .tab-content")
        .forEach((el) => el.classList.remove("active"));
      tab.classList.add("active");
      document
        .getElementById(tab.dataset.target)
        .classList.add("active");
    });
  });
</script>
