---
import Badge from "./Badge.astro";
---

<section
  class="flex items-center justify-between h-full min-h-screen px-20"
>
  <div class="flex flex-col items-start gap-7">
    <Badge label="Available for freelance work" />
    <h2
      class="text-[60px] font-bold text-text-primary leading-[115%]"
    >
      Full-Stack <br /> Web Developer
    </h2>
    <p class="text-[17px] text-text-muted leading-[160%]">
      I build scalable web applications, high-performance APIs, and <br
      />
      modern user experiences — from clean frontends to robust backend <br
      />systems.
    </p>
    <div class="flex items-center gap-3">
      <button class="btn-primary h-10.5 text-sm font-bold px-7"
        >View Projects</button
      >
      <button class="btn-secondary h-10.5 text-sm font-semibold px-7"
        >Contact Me</button
      >
    </div>
    <div class="flex items-center gap-7">
      <div class="flex flex-col items-start gap-0.5 font-mono">
        <h3 class="text-2xl font-bold text-cyan">7+</h3>
        <p class="text-xs text-text-muted">Years Exp.</p>
      </div>
      <div class="flex flex-col items-start gap-0.5 font-mono">
        <h3 class="text-2xl font-bold text-cyan">50+</h3>
        <p class="text-xs text-text-muted">Projects Built</p>
      </div>
    </div>
  </div>
  <img src="/hero.webp" alt="Hero Image" class="h-115 w-115" />
</section>
