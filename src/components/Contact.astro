---
import Badge from "./Badge.astro";
import ContactButton from "./ContactButton.astro";
import { CONTACTS } from "../../src/constants";
---

<section class="flex items-start w-full gap-20 p-20 bg-bg-base">
  <div class="flex flex-col items-start w-full gap-5">
    <Badge label="get_in_touch" />
    <h2 class="text-3xl font-bold text-text-primary">
      Let's Work <br /> Together
    </h2>
    <p class="text-[15px] text-text-muted">
      Have a project in mind? Looking for a developer who can take<br
      /> it from idea to production? I'm currently available for<br /> freelance
      work and open to full-time opportunities.
    </p>
    <div class="flex flex-col items-start w-full gap-3">
      {
        CONTACTS.map((contact) => (
          <ContactButton
            key={contact.label}
            icon={contact.icon}
            label={contact.label}
            value={contact.value}
          />
        ))
      }
    </div>
  </div>
  <div class="flex flex-col items-start w-full">
    <div class="flex items-start gap-6 pb-9">
      <div class="w-3 h-3 rounded-full bg-cyan"></div>
      <div class="flex flex-col items-start w-full gap-3">
        <div class="flex flex-col items-start">
          <h3 class="text-base font-bold text-text-primary">
            Full-Stack Developer
          </h3>
          <p class="font-mono text-[13px] font-medium text-cyan">
            Freelance — Remote
          </p>
        </div>
        <p class="text-[13px] text-text-muted leading-[165%]">
          Designing and delivering full-stack web applications for
          clients across e-commerce, booking, and SaaS. Sole engineer
          on most <br /> projects — from architecture to deployment.
        </p>
        <div class="flex items-center gap-1.5 w-full">
          <div
            class="bg-bg-dark border border-border-faint py-0.75 px-2 rounded"
          >
            <p class="font-mono text-[11px] text-text-secondary">
              Next.js
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="flex items-start gap-6 pb-9">
      <div class="w-3 h-3 rounded-full bg-cyan"></div>
      <div class="flex flex-col items-start w-full gap-3">
        <div class="flex flex-col items-start">
          <h3 class="text-base font-bold text-text-primary">
            Full-Stack Developer
          </h3>
          <p class="font-mono text-[13px] font-medium text-cyan">
            Freelance — Remote
          </p>
        </div>
        <p class="text-[13px] text-text-muted leading-[165%]">
          Designing and delivering full-stack web applications for
          clients across e-commerce, booking, and SaaS. Sole engineer
          on most <br /> projects — from architecture to deployment.
        </p>
        <div class="flex items-center gap-1.5 w-full">
          <div
            class="bg-bg-dark border border-border-faint py-0.75 px-2 rounded"
          >
            <p class="font-mono text-[11px] text-text-secondary">
              Next.js
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="flex items-start gap-6 pb-9">
      <div class="w-3 h-3 rounded-full bg-cyan"></div>
      <div class="flex flex-col items-start w-full gap-3">
        <div class="flex flex-col items-start">
          <h3 class="text-base font-bold text-text-primary">
            Full-Stack Developer
          </h3>
          <p class="font-mono text-[13px] font-medium text-cyan">
            Freelance — Remote
          </p>
        </div>
        <p class="text-[13px] text-text-muted leading-[165%]">
          Designing and delivering full-stack web applications for
          clients across e-commerce, booking, and SaaS. Sole engineer
          on most <br /> projects — from architecture to deployment.
        </p>
        <div class="flex items-center gap-1.5 w-full">
          <div
            class="bg-bg-dark border border-border-faint py-0.75 px-2 rounded"
          >
            <p class="font-mono text-[11px] text-text-secondary">
              Next.js
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
