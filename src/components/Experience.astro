---
import Badge from "./Badge.astro";
import ExperienceBlock from "./ExperienceBlock.astro";
---

<section class="flex items-start w-full gap-20 p-20">
  <div class="flex flex-col items-start gap-2.5 w-full">
    <Badge label="experience" />
    <h2 class="text-3xl font-bold text-text-primary">
      Work & <br /> Experience
    </h2>
    <p class="text-[15px] text-text-muted">
      Building real products for real users across <br /> freelance and
      agency environments.
    </p>
  </div>
  <div class="flex flex-col items-start w-full">
    <ExperienceBlock />
    <ExperienceBlock />
  </div>
</section>
