---
import Badge from "./Badge.astro";
---

<section class="w-full p-20 bg-bg-base">
  <div class="flex flex-col items-start gap-5">
    <Badge label="about_me" />
    <h2 class="text-4xl font-bold text-text-primary">
      Building products that <br /> actually ship.
    </h2>
    <p class="text-text-muted text-[15px] leading-[170%]">
      I'm a full-stack developer specializing in building
      production-grade <br />web applications from the ground up. I
      care deeply about <br />performance, clean architecture, and
      developer experience.
    </p>
    <p class="text-text-muted text-[15px] leading-[170%]">
      From designing database schemas to crafting responsive UIs — I<br
      />
      focus on shipping complete, scalable systems using modern<br />
      frameworks and best practices.
    </p>
  </div>
</section>
